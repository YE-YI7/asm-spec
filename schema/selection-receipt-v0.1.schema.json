{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YE-YI7/asm-spec/main/schema/selection-receipt-v0.1.schema.json",
  "title": "ASM Selection Receipt v0.1",
  "description": "Unsigned audit record of one deterministic service-selection decision. It records the evidence and constraints used to choose a service; it is not authorization, execution evidence, or a signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "receipt_version",
    "selection_id",
    "issued_at",
    "selector",
    "request",
    "evidence",
    "selected",
    "selection_reason",
    "risk_class",
    "approval_required",
    "side_effects",
    "alternatives",
    "rejected"
  ],
  "properties": {
    "receipt_type": { "const": "selection" },
    "receipt_version": { "const": "0.1" },
    "selection_id": { "type": "string", "minLength": 1 },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "selector": { "$ref": "#/$defs/selector" },
    "request": { "$ref": "#/$defs/request" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "selected": {
      "oneOf": [
        { "$ref": "#/$defs/selected" },
        { "type": "null" }
      ]
    },
    "selection_reason": { "type": "string", "minLength": 1 },
    "risk_class": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "approval_required": { "type": ["boolean", "null"] },
    "side_effects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "alternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/alternative" }
    },
    "rejected": {
      "type": "array",
      "items": { "$ref": "#/$defs/rejected" }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "policy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "taxonomy",
        "agent_reach",
        "user_platform",
        "required_functions",
        "require_approval_for",
        "require_agent_completable_setup"
      ],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "taxonomy": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "agent_reach": { "type": "string", "minLength": 1 },
        "user_platform": { "type": "string", "minLength": 1 },
        "required_functions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "require_approval_for": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "require_agent_completable_setup": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "manifest_digest"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "manifest_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "display_name",
        "monthly_cost_usd",
        "interface",
        "reach",
        "agent_completable_setup",
        "setup_requires"
      ],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "monthly_cost_usd": { "type": "number", "minimum": 0 },
        "interface": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "reach": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "agent_completable_setup": { "type": ["boolean", "null"] },
        "setup_requires": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "display_name", "monthly_cost_usd"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "monthly_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "service_id", "reason"],
      "properties": {
        "service": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "service_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
