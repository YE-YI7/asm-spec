{
  "name": "asm-registry",
  "version": "0.3.0",
  "description": "ASM Registry — MCP Server for querying Agent Service Manifests",
  "main": "dist/index.js",
  "bin": {
    "asm-registry": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:http": "tsx src/http.ts",
    "test": "npm run build && tsx src/test_scorer.ts && tsx src/test_topsis.ts && tsx src/test_mcp_server.ts",
    "test:topsis": "tsx src/test_topsis.ts"
  },
  "keywords": [
    "asm",
    "mcp",
    "agent",
    "service-manifest"
  ],
  "author": "Caleb (yi guo)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.3.6",
    "express": "^4.22.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17"
  }
}
